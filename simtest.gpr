--
--  The headless checks: the race without a window
with "gtkada";

project Simtest is
   for Source_Dirs use ("src", "tests");
   for Source_Files use ("geom.ads", "geom.adb", "tracks.ads", "tracks.adb",
                         "cars.ads", "cars.adb", "race.ads", "race.adb", "art.ads", "art.adb", "scene.ads", "scene.adb", "hud.ads", "hud.adb", "net.ads", "net.adb",
                         "simtest.adb", "shot.adb", "nettest.adb");
   for Object_Dir use "obj/test";
   for Exec_Dir use "bin";
   for Main use ("simtest.adb", "shot.adb", "nettest.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2012", "-gnatwa", "-gnatyN", "-gnatwU", "-gnata");
   end Compiler;
end Simtest;
