with "gtkada";

project Adamachines is
   for Source_Dirs use ("src");
   for Object_Dir use "obj/game";
   for Exec_Dir use "bin";
   for Main use ("adamachines.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2012", "-gnatwa", "-gnatyN", "-gnatwU");
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use ("-lpulse-simple", "-lpulse");
   end Linker;
end Adamachines;
